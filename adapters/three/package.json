{
  "name": "@tessifc/three",
  "version": "0.3.0",
  "description": "three.js meshes from a TessIFC model",
  "license": "Apache-2.0",
  "author": "Bharathi Kannan",
  "type": "module",
  "main": "src/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./build": {
      "types": "./types/build.d.ts",
      "default": "./src/build.js"
    },
    "./retained": {
      "types": "./types/retained.d.ts",
      "default": "./src/retained.js"
    }
  },
  "files": [
    "src/",
    "types/",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "keywords": [
    "ifc",
    "bim",
    "three",
    "threejs",
    "tessifc"
  ],
  "homepage": "https://github.com/nbharathik/tessifc#readme",
  "bugs": {
    "url": "https://github.com/nbharathik/tessifc/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nbharathik/tessifc.git",
    "directory": "adapters/three"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node test/build.test.mjs && node test/retained.test.mjs",
    "types": "node ../../scripts/build-types.mjs .",
    "typecheck": "node ../../scripts/build-types.mjs --check .",
    "prepack": "npm run types"
  },
  "peerDependencies": {
    "three": ">=0.150.0"
  },
  "publishConfig": {
    "access": "public",
    "tag": "preview"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": false
    }
  }
}
