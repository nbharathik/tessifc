{
  "name": "tessifc-workspace",
  "private": true,
  "description": "The npm workspace of the tessifc checkout: the published packages, the viewer application and the shared tooling",
  "license": "Apache-2.0",
  "author": "Bharathi Kannan",
  "type": "module",
  "workspaces": [
    "bindings/wasm",
    "bindings/edit",
    "bindings/viewer",
    "bindings/mcp",
    "adapters/three",
    "viewer"
  ],
  "scripts": {
    "test": "npm test --workspaces --if-present",
    "types": "node scripts/build-types.mjs",
    "typecheck": "node scripts/build-types.mjs --check && tsc -p examples/tsconfig.json",
    "pack:all": "npm pack --workspace @tessifc/core --workspace @tessifc/edit --workspace @tessifc/viewer --workspace @tessifc/mcp --workspace @tessifc/three --pack-destination dist"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "@types/three": "0.186.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
